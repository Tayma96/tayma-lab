# Twitch: https://dev.twitch.tv/console/apps -> uygulama oluştur
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Canlı avcı için (gta6clips auth twitch). Twitch uygulamasına bu adresi OAuth Redirect URL olarak ekle:
TWITCH_REDIRECT_URI=http://localhost:8767/callback
TWITCH_USER_TOKEN_FILE=secrets/twitch_user_token.json

# Claude (başlık/açıklama/hashtag üretimi). Boşsa şablon metin kullanılır.
ANTHROPIC_API_KEY=

# YouTube: Google Cloud Console -> OAuth client (Desktop) -> JSON'u indir
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# TikTok tarayıcı yöntemi (method: browser): TikTok'a tarayıcıda giriş yap, "Get cookies.txt LOCALLY"
# eklentisiyle çerezleri secrets/tiktok_cookies.txt olarak kaydet. Ya da sadece sessionid çerezini yaz:
TIKTOK_COOKIES_FILE=secrets/tiktok_cookies.txt
TIKTOK_SESSIONID=

# YouTube kanal yönetimi için yutu MCP (ayrı token dosyası; `yutu auth` oluşturur)
YUTU_CREDENTIAL=secrets/youtube_client_secret.json
YUTU_CACHE_TOKEN=secrets/yutu_token.json

# TikTok API yöntemi (method: api): developers.tiktok.com -> Content Posting API (video.publish scope)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_FILE=secrets/tiktok_token.json
TIKTOK_REDIRECT_URI=http://localhost:8765/callback
