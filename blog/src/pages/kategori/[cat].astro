---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { slugify } from '../../lib/site';
import { getPublishedPosts, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((c) => ({ params: { cat: slugify(c) }, props: { name: c, posts: posts.filter((p) => p.data.category === c) } }));
}
const { name, posts } = Astro.props as { name: string; posts: Post[] };
---
<Base title={`${name} rehberleri`} description={`${name} konusunda pazaryeri satıcıları için rehberler.`} path={`kategori/${slugify(name)}/`}>
  <h1>{name}</h1>
  <section class="list">{posts.map((p) => <PostCard post={p} />)}</section>
</Base>
