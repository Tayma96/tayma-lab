---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { cfg, absUrl, slugify } from '../../lib/site';
import { getPublishedPosts, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((c) => ({ params: { cat: slugify(c) }, props: { name: c, posts: posts.filter((p) => p.data.category === c) } }));
}
const { name, posts } = Astro.props as { name: string; posts: Post[] };
const path = `kategori/${slugify(name)}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${name} rehberleri`,
  description: `${name} konusunda pazaryeri satıcıları için rehberler.`,
  url: absUrl(path),
  inLanguage: 'tr-TR',
  isPartOf: { '@type': 'WebSite', name: cfg.siteName, url: absUrl() },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: absUrl(`yazilar/${p.id}/`),
      name: p.data.title,
    })),
  },
};
---
<Base title={`${name} rehberleri`} description={`${name} konusunda pazaryeri satıcıları için rehberler.`} path={path} jsonLd={jsonLd}>
  <h1>{name}</h1>
  <section class="list">{posts.map((p) => <PostCard post={p} />)}</section>
</Base>
