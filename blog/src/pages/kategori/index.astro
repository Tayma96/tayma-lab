---
import Base from '../../layouts/Base.astro';
import { url, slugify } from '../../lib/site';
import { getPublishedPosts } from '../../lib/posts';
const posts = await getPublishedPosts();
const cats = new Map<string, number>();
posts.forEach((p) => cats.set(p.data.category, (cats.get(p.data.category) ?? 0) + 1));
---
<Base title="Kategoriler" description="Satıcı Rehberi konu kategorileri: komisyon, kargo, iade, hakediş, e-Arşiv fatura, KVKK ve fiyatlandırma." path="kategori/">
  <h1>Kategoriler</h1>
  <ul class="cats">
    {[...cats.entries()].sort().map(([c, n]) => <li><a href={url(`kategori/${slugify(c)}/`)}>{c}</a> ({n})</li>)}
  </ul>
</Base>
