---
import Base from './Base.astro';
interface Props { title: string; description: string; path: string; needsReview?: boolean }
const { title, description, path, needsReview = false } = Astro.props;
---
<Base title={title} description={description} path={path}>
  <article class="post">
    <h1>{title}</h1>
    {needsReview && (
      <div class="review-banner" role="note">
        <strong>TASLAK — HUKUKİ İNCELEME GEREKİR.</strong> Bu metin bir şablondur; yayına almadan önce bir hukuk uzmanı tarafından
        gözden geçirilmeli ve veri sorumlusu bilgileri doldurulmalıdır.
      </div>
    )}
    <div class="prose"><slot /></div>
  </article>
</Base>
