---
/**
 * Reklam alanı. site.config.json -> ads.adsenseClientId ve ads.slots[name]
 * doluysa AdSense birimi basar; değilse HİÇBİR ŞEY render etmez.
 */
import { cfg } from '../lib/site';
interface Props { name: string }
const { name } = Astro.props;
const client: string = cfg.ads?.adsenseClientId ?? '';
const slot: string = cfg.ads?.slots?.[name] ?? '';
const enabled = Boolean(client && slot);
---
{enabled && (
  <aside class="ad-slot" aria-label="Reklam">
    <span class="ad-label">Reklam</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
