---
import { url, formatDate, slugify } from '../lib/site';
import type { Post } from '../lib/posts';
interface Props { post: Post }
const { post } = Astro.props;
---
<article class="card">
  <p class="meta"><a href={url(`kategori/${slugify(post.data.category)}/`)}>{post.data.category}</a> · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
  <h2><a href={url(`yazilar/${post.id}/`)}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
</article>
