---
import { url } from '../lib/site';
---
<div id="cookie-notice" class="cookie" hidden>
  <p>Bu site temel işleyiş için tarayıcı depolaması kullanır; reklam/analitik etkinleştirilirse çerez kullanılabilir. Ayrıntılar: <a href={url('gizlilik-ve-cerezler/')}>Gizlilik, KVKK ve Çerez Politikası</a>.</p>
  <button type="button" id="cookie-ok">Anladım</button>
</div>
<script is:inline>
  (function () {
    try {
      var k = 'sr_cookie_ok';
      var el = document.getElementById('cookie-notice');
      if (!localStorage.getItem(k)) el.hidden = false;
      document.getElementById('cookie-ok').addEventListener('click', function () {
        localStorage.setItem(k, '1'); el.hidden = true;
      });
    } catch (e) {}
  })();
</script>
