---
/** Yazı sonunda önerilen araçlar kutusu. Hiçbir programın ID'si yoksa render edilmez. */
import { cfg, url } from '../lib/site';
import AffiliateLink from './AffiliateLink.astro';
const keys: string[] = (cfg.affiliate?.showOnPosts ?? []).filter((k: string) => cfg.affiliate?.programs?.[k]?.id);
---
{keys.length > 0 && (
  <aside class="aff-box" aria-label="Önerilen araçlar">
    <h2>İşinizi kolaylaştırabilecek araçlar</h2>
    <ul>
      {keys.map((k) => (
        <li><AffiliateLink program={k} /> — {cfg.affiliate.programs[k].description}</li>
      ))}
    </ul>
    <p class="small">Bu kutudaki bağlantılar ortaklık bağlantısıdır; üzerinden alışveriş yapılırsa komisyon alabiliriz. <a href={url('ortaklik-aciklamasi/')}>Ayrıntılar</a>.</p>
  </aside>
)}
